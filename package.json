{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"npm:dev:server\" \"node scripts/wait-for-api.mjs && npm run dev:web\"",
    "dev:web": "vite",
    "dev:server": "nodemon --watch server/src --watch src/data/portfolioData.ts --watch server/.env --ext ts,env --delay 500ms --exec \"npm run build:server && node server/dist/server/src/index.js\"",
    "dev:all": "npm run dev",
    "server": "node server/dist/server/src/index.js",
    "build:server": "tsc -p server/tsconfig.json",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "typecheck": "tsc -b && npm run typecheck:server",
    "test:server": "npm run build:server && node --test server/dist/server/src/tests/chat.test.js",
    "build": "tsc -b && npm run build:server && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "motion": "^14.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  }
}
